{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix web ci && npm --prefix web run build && python scripts/prepare_vercel.py",
  "functions": {
    "server.py": {
      "maxDuration": 120,
      "includeFiles": "{data/parkguide.sqlite,data/evaluation/gold-draft-manifest.json,data/evaluation/gold-drafts.jsonl,config/**,vendor/tiktoken/**,src/**,public/**}",
      "excludeFiles": "{web/**,artifacts/**,tests/**,app.py,data/raw/**,data/embedding-cache/**,data/diagnostics/**,{reports,docs,dashboard,scripts,.pytest_cache}/**,data/*.json*,data/evaluation/{G*,diagnostic*,dialogues*,gold-authored*},**/__pycache__/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "framework": "fastapi"
}
